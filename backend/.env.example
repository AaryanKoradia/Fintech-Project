MONGODB_URI=mongodb://localhost:27017/fintech_3c

JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://fintech-3c.vercel.app

GEMINI_API_KEY=your-gemini-api-key-here

ULTRAMSG_INSTANCE=your-ultramsg-instance-id
ULTRAMSG_TOKEN=your-ultramsg-token

# Phone number (digits only, country code, no +) allowed to use the WhatsApp bot's
# assistant-mode commands. Leave unset to disable that check entirely.
WHATSAPP_AUTHORIZED_NUMBER=

# Shared secret for verifying Exotel voice-call webhooks, if/when that is added.
EXOTEL_WEBHOOK_SECRET=

# Admin credentials -- used only by `python -m app.init_admin` to bootstrap the
# first admin account. Not read anywhere else. Set a real, unique password
# before running it, then rotate it after first login.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_NAME=Admin
