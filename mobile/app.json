{
  "expo": {
    "name": "Sakhi",
    "slug": "sakhi-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.svg",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.svg",
      "resizeMode": "contain",
      "backgroundColor": "#2596be"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sakhi.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.svg",
        "backgroundColor": "#2596be"
      },
      "package": "com.sakhi.mobile",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.svg"
    },
    "plugins": [
      "expo-secure-store",
      "expo-location",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Sakhi to access your camera for document scanning."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Sakhi to access your photos for document uploads."
        }
      ]
    ]
  }
}
